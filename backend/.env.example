# Database (usa estas credenciales con docker-compose)
DATABASE_URL="postgresql://tapaybusca:tapaybusca@localhost:5432/tapaybusca"

# JWT
JWT_SECRET="your-secret-key-here"
JWT_EXPIRE_IN="24h"

# Server
PORT=3001
# Optional: public base URL of this API (e.g. https://your-app.onrender.com). If unset, logs show http://localhost:PORT
# API_BASE_URL="https://your-app.onrender.com"
NODE_ENV=development

# Frontend (para construir el enlace de reset)
FRONTEND_BASE_URL="http://localhost:5173"

# Password reset
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# SMTP (email)
# Gmail: usar host smtp.gmail.com y "Contraseña de aplicación" (no la contraseña de la cuenta)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="tapa.y.busca.admin@gmail.com"
SMTP_PASS="cmme kybz wiaq csez"
MAIL_FROM="Tapa y Busca <tapa.y.busca.admin@gmail.com>"