# Database (usa estas credenciales con docker-compose)
DATABASE_URL="postgresql://tapaybusca:tapaybusca@localhost:5432/tapaybusca"

# JWT
JWT_SECRET="your-secret-key-here"
JWT_EXPIRE_IN="24h"

# Server
PORT=3001
NODE_ENV=development

# Frontend (para construir el enlace de reset)
FRONTEND_BASE_URL="http://localhost:5173"

# Password reset
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# SMTP (email)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="user@example.com"
SMTP_PASS="your-smtp-password"
MAIL_FROM="Tapa y Busca <no-reply@example.com>"
