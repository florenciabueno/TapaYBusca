# Database (use these credentials with docker-compose)
DATABASE_URL="postgresql://tapaybusca:tapaybusca@localhost:5432/tapaybusca"

# JWT
JWT_SECRET="your-secret-key-here"
JWT_EXPIRE_IN="24h"

# Server
PORT=3001
# Optional: public base URL of this API (e.g. https://your-app.onrender.com). If unset, logs show http://localhost:PORT
# API_BASE_URL="https://your-app.onrender.com"
NODE_ENV=development

# Frontend (used to build the password reset link)
FRONTEND_BASE_URL="http://localhost:5173"

# Password reset
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Email (Gmail HTTPS API; works on Render where outbound SMTP is blocked).
# The email part of MAIL_FROM MUST equal the Gmail account that owns the OAuth refresh token.
# Setup: Google Cloud Console -> enable Gmail API -> OAuth client (Web) ->
# OAuth Playground (scope https://www.googleapis.com/auth/gmail.send) -> copy refresh token.
MAIL_FROM="Tapa y Busca <tapa.y.busca.admin@gmail.com>"
GMAIL_OAUTH_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GMAIL_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"
GMAIL_OAUTH_REFRESH_TOKEN="your-google-oauth-refresh-token"

