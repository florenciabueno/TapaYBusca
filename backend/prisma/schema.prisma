// This is your Prisma schema file,
// learn more about everything in the https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EquationStatus {
  NOT_STARTED
  IN_PROGRESS
  SOLVED
}

enum EquationOrigin {
  DEFAULT
  CREATED
  DOWNLOADED
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  name                String
  passwordHash        String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  createdEquations    Equation[] @relation("CreatedEquations")
  userEquations       UserEquation[]
  publishedEquations  PublishedEquation[]

  @@map("users")
}

model Equation {
  id                  String   @id @default(uuid())
  postfixExpression   String
  creatorId           String?
  isDefault           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  creator             User?    @relation("CreatedEquations", fields: [creatorId], references: [id])
  userEquations       UserEquation[]
  publishedEquations  PublishedEquation[]

  @@map("equations")
}

model UserEquation {
  id          String         @id @default(uuid())
  userId      String
  equationId  String
  status      EquationStatus @default(NOT_STARTED)
  origin      EquationOrigin
  isActive    Boolean        @default(true)
  addedAt     DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  equation    Equation       @relation(fields: [equationId], references: [id], onDelete: Cascade)

  @@unique([userId, equationId])
  @@map("user_equations")
}

model PublishedEquation {
  id              String   @id @default(uuid())
  equationId      String
  userId          String
  publishedAt     DateTime @default(now())
  
  equation        Equation @relation(fields: [equationId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([equationId, userId])
  @@map("published_equations")
}
