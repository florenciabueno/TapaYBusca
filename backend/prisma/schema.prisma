// This is your Prisma schema file,
// learn more about everything in the https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EquationStatus {
  NOT_STARTED
  IN_PROGRESS
  SOLVED
}

enum EquationOrigin {
  DEFAULT
  CREATED
  DOWNLOADED
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  name                String
  passwordHash        String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  createdEquations    Equation[] @relation("CreatedEquations")
  userEquations       UserEquation[]
  publishedEquations  PublishedEquation[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Equation {
  id                  String   @id @default(uuid())
  postfixExpression   String
  infixExpression     String?
  latexExpression     String?
  solutionValues      Json?
  creatorId           String?
  isDefault           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  creator             User?    @relation("CreatedEquations", fields: [creatorId], references: [id])
  userEquations       UserEquation[]
  publishedEquations  PublishedEquation[]

  @@map("equations")
}

model UserEquation {
  id                   String         @id @default(uuid())
  userId               String
  equationId           String
  status               EquationStatus @default(NOT_STARTED)
  origin               EquationOrigin
  isActive             Boolean        @default(true)
  currentResolutionId  Int            @default(0)
  selectedBranch       String         @default("")
  addedAt              DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  equation    Equation     @relation(fields: [equationId], references: [id], onDelete: Cascade)
  resolutions Resolution[]

  @@unique([userId, equationId])
  @@map("user_equations")
}

model Resolution {
  id                  String   @id @default(uuid())
  userEquationId      String
  resolutionSessionId Int
  subEquation         String
  subEquationInfix    String?
  proposedResult      String
  resultValue         String
  createdAt           DateTime @default(now())
  stepWithoutSolution Boolean  @default(false)
  isCorrect           Boolean  @default(false)
  isVariable          Boolean  @default(false)
  resolutionSide      Int

  userEquation UserEquation @relation(fields: [userEquationId], references: [id], onDelete: Cascade)

  @@index([userEquationId, resolutionSessionId])
  @@map("resolutions")
}

model PublishedEquation {
  id              String   @id @default(uuid())
  equationId      String
  userId          String
  publishedAt     DateTime @default(now())
  
  equation        Equation @relation(fields: [equationId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([equationId, userId])
  @@map("published_equations")
}
